<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Browser playtest build. Runs the exact same Core simulation and content as the Unity game. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <CompressionEnabled>false</CompressionEnabled>
    <RootNamespace>HikariForge.M313.Playtest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/_Project/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Assets/_Project/Resources/Content/*.json" LogicalName="Content.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.32" />
  </ItemGroup>
</Project>
