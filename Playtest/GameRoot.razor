                <label class="set">Music volume <input type="range" min="0" max="1" step="0.05" value="@st.Music" @onchange="async e => { st.Music = float.Parse(e.Value.ToString(), System.Globalization.CultureInfo.InvariantCulture); await S.SaveSettings(); }" /></label>
                <label class="set">Sound effects <input type="range" min="0" max="1" step="0.05" value="@st.Sfx" @onchange="async e => { st.Sfx = float.Parse(e.Value.ToString(), System.Globalization.CultureInfo.InvariantCulture); await S.SaveSettings(); }" /></label>
