                <label class="set">Game speed (playtest)
                    <select value="@st.Speed.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="async e => { st.Speed = float.Parse(e.Value.ToString(), System.Globalization.CultureInfo.InvariantCulture); await S.SaveSettings(); }">
