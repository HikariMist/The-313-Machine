    RenderFragment FailedScreen() => __builder =>
    {
        <div class="result failed-bg">
            <div class="card">
                <div class="eyebrow">SHIFT TERMINATED</div>
                <h2>@(S.FailReason == "collapse" ? "You lost yourself" : "You made a mistake")</h2>
                @foreach (var l in S.FailLines) { <p class="@(l.StartsWith("*") ? "narr" : "")">@l.TrimStart('*')</p> }
                <p class="dim">Check the handbook and the cameras. Every death in this game is avoidable with information you have.</p>
                <div class="row">
                    <button class="btn primary" @onclick="S.RetryNight">Retry the night</button>
                    <button class="btn ghost" @onclick="() => S.Screen = Screen.Title">Main menu</button>
                </div>
            </div>
        </div>
