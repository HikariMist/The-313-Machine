    RenderFragment EndingScreen() => __builder =>
    {
        var e = S.Ending;
        int idx = S.Db.Endings.IndexOf(e) + 1;
        <div class="result ending-bg">
            <div class="card ending">
                <div class="eyebrow">ENDING @(S.Profile.EndingCount(S.Db)) OF 15 DISCOVERED</div>
                <h2>@e.Title</h2>
                @foreach (var l in e.Lines) { <p class="@(l.StartsWith("*") ? "narr" : "")">@l.TrimStart('*')</p> }
                @foreach (var a in S.NewAchievements)
                {
                    <div class="achievement">🏆 Achievement unlocked: <b>@AchName(a)</b></div>
                }
                <div class="row">
                    <button class="btn primary big" @onclick="S.NextCycle">Begin cycle @(S.State.Cycle + 1)</button>
                    <button class="btn ghost" @onclick="() => S.Screen = Screen.Achievements">Endings</button>
                    <button class="btn ghost" @onclick="() => S.Screen = Screen.Credits">Credits</button>
                </div>
                <p class="dim">The machine never really stops. A new cycle starts at Night 1 — and Unit 313 will remember you.</p>
            </div>
        </div>
    };

    string AchName(string id)
    {
        if (id == Profile.EndlessAchievement) return "The Minute Never Closes — Endless Mode unlocked";
        var e = S.Db.Endings.FirstOrDefault(x => Profile.AchievementFor(x.Id) == id);
        return e == null ? id : EndingAchievement(e).name;
    }

    (string name, string desc) EndingAchievement(EndingDef e) => e.Id switch
    {
        _ => (AchTitles.TryGetValue(e.Id, out var t) ? t.n : e.Title, AchTitles.TryGetValue(e.Id, out var d) ? d.d : "")
    };

    static readonly Dictionary<string, (string n, string d)> AchTitles = new()
    {
        ["truth"] = ("Clause Thirteen", "Break the contract and send Coach 313 home."),
        ["escape"] = ("Clocked Out", "Refuse the Collector and walk away alone."),
        ["replacement"] = ("Employee No. 0", "Sign the ledger and become the machine."),
        ["debt"] = ("Paid in Installments", "Refuse the Collector after taking too many of his deals."),
        ["empty_seat"] = ("One Seat Short", "Break the contract without keeping Lily safe."),
        ["last_passenger"] = ("Waiting for the 2:58", "Break the contract while Mr. Crane still doesn't know where he's going."),
        ["driver"] = ("Behind the Wheel", "Break the contract before Walter was ready to go."),
        ["nameless"] = ("No Names, No Faces", "Enter the date without the passenger manifest."),
        ["wrong_minute"] = ("Trust the Seal", "Enter the forged override code."),
        ["paid_in_full"] = ("Exact Change", "Pay the Collector with exact change."),
        ["maras_shift"] = ("Taking Over", "Sign the ledger to free Mara."),
        ["company_man"] = ("District Supervisor", "Hand Mara's evidence to Hale, then sign."),
        ["together"] = ("Yellow Raincoat", "Refuse the Collector with Lily safe beside you."),
        ["ones_who_left"] = ("Their Own Way Home", "Help Walter, Mr. Crane and Lily, then refuse the Collector."),
        ["off_the_clock"] = ("Rule A2", "Leave the attendant booth during a shift.")
    };

    RenderFragment AchievementsScreen() => __builder =>
    {
        bool endless = S.Profile.EndlessUnlocked(S.Db);
        <div class="result">
            <div class="card wide">
                <div class="eyebrow">@S.Profile.EndingCount(S.Db) OF 15 ENDINGS · @S.Profile.CyclesCompleted CYCLES PLAYED</div>
                <h2>Endings &amp; Achievements</h2>
                <div class="ach-grid">
                    @foreach (var e in S.Db.Endings)
                    {
                        bool got = S.Profile.Endings.Contains(e.Id);
                        var a = EndingAchievement(e);
                        <div class="ach @(got ? "got" : "")">
                            <div class="ach-name">@(got ? a.name : "???")</div>
                            <div class="ach-title">@(got ? e.Title : "Undiscovered ending")</div>
                            <div class="ach-desc">@(got ? a.desc : HintFor(e.Id))</div>
                        </div>
                    }
                    <div class="ach endless @(endless ? "got" : "")">
                        <div class="ach-name">The Minute Never Closes</div>
                        <div class="ach-title">Endless Mode</div>
                        <div class="ach-desc">@(endless ? $"Unlocked. Best: round {S.Profile.EndlessBestRound}, {Money(S.Profile.EndlessBestEarnings)}." : "Discover all 15 endings.")</div>
                    </div>
                </div>
                <button class="btn" @onclick="() => S.Screen = Screen.Title">Back</button>
            </div>
        </div>
    };

    static string HintFor(string id) => id switch
    {
        "off_the_clock" => "Some rules exist for a reason.",
        "wrong_minute" => "Not every page in the handbook is real.",
        "paid_in_full" => "Thirteen coins, from thirteen people.",
        "company_man" => "Hale is always looking for loyal staff.",
        "debt" => "Every deal is written down.",
        "truth" => "The date. Every name. Nobody left behind.",
        _ => "Your choices across the seven nights decide this one."
    };

