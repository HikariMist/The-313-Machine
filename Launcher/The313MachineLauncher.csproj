<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dedicated launcher for THE 3:13 MACHINE (itch.io / direct installs; Steam launches the game directly).
       Avalonia UI so the Windows build can be produced on any OS:
       dotnet publish -c Release -o ../Release/launcher  → The313MachineLauncher.exe (self-contained, no .NET install)
       plus Intro\Hikari_Forge_Studios_Startup_Intro.mp4 beside it.
       WPF is used only for the studio intro's MediaElement (StudioIntroPlayer); EnableWindowsTargeting keeps
       the build working on Linux/macOS. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>The313MachineLauncher</AssemblyName>
    <RootNamespace>HikariForge.M313.Launcher</RootNamespace>
    <Version>0.9.0</Version>
    <Company>Hikari Forge Studios</Company>
    <Product>The 3:13 Machine Launcher</Product>
    <Copyright>© Hikari Forge Studios</Copyright>
    <ApplicationIcon>Assets/launcher.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF text layout (intro skip hint) needs real culture data; invariant mode makes it throw. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF removes System.IO from the implicit usings; the launcher code relies on it. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- MediaElement plays from a file path, so the cinematic stays a loose file next to the exe.
         Single source: the same MP4 the Unity game plays from StreamingAssets. -->
    <None Include="..\Assets\StreamingAssets\Hikari_Forge_Studios_Startup_Intro.mp4" Link="Intro\Hikari_Forge_Studios_Startup_Intro.mp4"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
