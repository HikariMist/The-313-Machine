<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dedicated launcher for THE 3:13 MACHINE (itch.io / direct installs; Steam launches the game directly).
       Avalonia UI so the Windows build can be produced on any OS:
       dotnet publish -c Release -o ../Release/launcher  → The313MachineLauncher.exe (self-contained, no .NET install). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>The313MachineLauncher</AssemblyName>
    <RootNamespace>HikariForge.M313.Launcher</RootNamespace>
    <Version>0.9.0</Version>
    <Company>Hikari Forge Studios</Company>
    <Product>The 3:13 Machine Launcher</Product>
    <Copyright>© Hikari Forge Studios</Copyright>
    <ApplicationIcon>Assets/launcher.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
